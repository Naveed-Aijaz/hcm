# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB Atlas (required) ----
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/hcm_lite?retryWrites=true&w=majority
# Set to true only if Atlas SRV lookups fail on your network
USE_PUBLIC_DNS=true

# ---- Auth (required) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes

# ---- CORS (required) ----
# Comma-separated frontend ORIGINS: scheme + host only, NO path or trailing slash.
CLIENT_URL=http://localhost:5173
# e.g. production: CLIENT_URL=https://your-frontend.vercel.app

# ---- Attendance / office rules ----
OFFICE_TIMEZONE=Asia/Karachi
OFFICE_START_HOUR=9
OFFICE_GRACE_MINUTES=15

# ---- AI assistant (optional; chat is disabled with a clear error if unset) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ---- Email (optional; not used by any current feature) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- Uploads ----
UPLOAD_MAX_SIZE_MB=1

# ---- Seeding (local throw-away DB only!) ----
# ALLOW_SEED=true
