NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/hcm_lite?retryWrites=true&w=majority

# Generate a strong secret; never use this placeholder in production
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL
CLIENT_URL=http://localhost:5173

# Email configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Password reset
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Upload configuration
UPLOAD_PROVIDER=local
UPLOAD_MAX_SIZE_MB=5